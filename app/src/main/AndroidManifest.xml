<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.juan.proyectcoop">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectCoop"
        tools:targetApi="31">

        <!-- Actividades del paquete com.kevin.basesdedatoslocalesk.controller -->
        <activity
            android:name="com.kevin.basesdedatoslocalesk.controller.EditarParticipante"
            android:exported="false" />
        <activity
            android:name="com.kevin.basesdedatoslocalesk.controller.ItemParticipante"
            android:exported="false" />
        <activity
            android:name="com.kevin.basesdedatoslocalesk.controller.ListaParticipantes"
            android:exported="false" />
        <activity
            android:name="com.kevin.basesdedatoslocalesk.controller.Registro_participantes"
            android:exported="true" />
        <activity
            android:name="com.kevin.basesdedatoslocalesk.controller.MainActivity"
            android:exported="false" />

        <!-- Gestión de actividades -->
        <activity
            android:name=".controller.crear_actividadActivity"
            android:exported="true" />
        <activity
            android:name=".controller.lista_actividadesActivity"
            android:exported="false" />
        <activity
            android:name=".controller.item_actividadActivity"
            android:exported="false" />

        <!-- Registro de usuarios -->
        <activity
            android:name="com.kevin.basesdedatoslocalesk.RegistroUsuarios"
            android:exported="true" />

        <!-- Login como pantalla principal (launcher) -->
        <activity
            android:name="com.kevin.basesdedatoslocalesk.LoginUsuarios"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
